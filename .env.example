# ── .env.local (frontend-safe, commit .env.example only, never .env.local) ───
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_public_jwt_here
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# ── .env.server.local (server-only — NEVER prefix with VITE_) ────────────────
# Load these only in Supabase Edge Functions, Node.js API routes, or CI jobs.
# They must NEVER appear in any file that Vite bundles (anything inside src/).
SUPABASE_SERVICE_ROLE_KEY=your_service_role_jwt_here
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxx
APP_BASE_URL=http://localhost:5173
